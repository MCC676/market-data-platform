<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.mccanto</groupId>
	<artifactId>mdp-pipeline</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<name>mdp-pipeline</name>
	<description>Spark + Iceberg ingestion pipeline for the Market Data Platform</description>

	<properties>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<spark.version>4.1.2</spark.version>
		<iceberg.version>1.11.0</iceberg.version>
	</properties>

	<profiles>
		<!-- Spark dependencies are heavy; keep the default build light. -->
		<profile>
			<id>spark</id>
			<dependencies>
				<dependency>
					<groupId>org.apache.spark</groupId>
					<artifactId>spark-sql_2.13</artifactId>
					<version>${spark.version}</version>
				</dependency>
				<dependency>
					<groupId>org.apache.iceberg</groupId>
					<artifactId>iceberg-spark-runtime-4.1_2.13</artifactId>
					<version>${iceberg.version}</version>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
	</profiles>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<configuration>
					<mainClass>com.mccanto.mdp.pipeline.IngestShipmentsJob</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
